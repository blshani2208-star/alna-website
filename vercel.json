{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/site",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/site/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ]
}
